{
  "name": "pottery-rib-maker",
  "private": true,
  "version": "0.1.0",
  "description": "Design 3D-printable profile ribs for throwing mugs, pots, and bowls, with a height scale on the rib.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aasimsani/pottery-rib-maker.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.worker.json && vite build",
    "dev:worker": "wrangler dev --port 8789",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "agents": "^0.32.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.2"
  }
}
