{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pottery-rib-maker",
  "account_id": "0166b7623c3b445802ae08ad398b3fcb",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // The app runs in the browser, so the Worker serves the Vite build as static assets, and src/cloudflare.ts
  // maps the /projects/ URL onto those files. worker/index.ts adds the MCP route and the live sessions in front of it.
  "main": "worker/index.ts",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": { "bindings": [{ "name": "SESSIONS", "class_name": "Session" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Session"] }],
  // Five new sessions a minute per IP, and 60 tool calls a minute per session.
  "ratelimits": [
    { "name": "SESSION_RATE", "namespace_id": "1005", "simple": { "limit": 5, "period": 60 } },
    { "name": "CALL_RATE", "namespace_id": "1006", "simple": { "limit": 60, "period": 60 } }
  ],
  "routes": [{ "pattern": "aasimsani.net/projects/pottery-rib-maker*", "zone_name": "aasimsani.net" }],
  // The workers.dev address stays on so that aasimsani.net can fall back to it.
  "workers_dev": true
}
